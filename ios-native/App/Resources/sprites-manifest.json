{
  "version": 1,
  "generator": "ios-native/tools/render-sprites.mjs (renders game/js/01…09 with three.js r170 in headless Chromium)",
  "projection": {
    "type": "orthographic 3/4 view, same yaw/pitch as the web camera (CAM_YAW 45°, CAM_PITCH 57°), no perspective",
    "yawDegrees": 45,
    "pitchDegrees": 57,
    "pointsPerMetre": 24,
    "pixelsPerMetre3x": 72,
    "pixelsPerMetre2x": 48,
    "worldAxes": "world x, z on the deck (sim coordinates of the web game), y up. The camera sits at +x,+z looking toward -x,-z.",
    "screenFromWorld": "u = (x - z) * 0.707107 * ppm ;  v = (y * 0.544639 - (x + z) * 0.707107 * 0.838671) * ppm   (u right, v up; ppm = 24 for SpriteKit points)",
    "screenFromWorldConstants": {
      "cosYaw": 0.707107,
      "sinPitch": 0.838671,
      "cosPitch": 0.544639
    },
    "depth": "nearness = (x + z) * 0.385118 + y * 0.838671  (larger = closer to the camera = draw later / higher zPosition)",
    "cellDiamondPoints": [
      33.9411,
      28.4654
    ],
    "heightStepPoints": 13.0713,
    "directions": "dir = Int((hd / (2π) * 16).rounded()) & 15 with hd = atan2(dx, dz) in WORLD space (the web game's heading / aim angle). dir 0 faces world +z (screen down-left), 4 faces +x (down-right), 8 faces -z (up-right), 12 faces -x (up-left); screen-up (the web FWD vector) is hd = 225° (dir 10)",
    "groundPlaneTextures": "flat textures (decals, telegraph rings, lanes, glow pools, pad marks) are top-down: put the SKSpriteNode (zRotation = world rotation) inside a container node with yScale = 0.838671 (= sin pitch) and zRotation = 0; world rotation r about +y maps to zRotation = r. Size in points = metres * 24. Exact for an orthographic camera (x,z -> rotate 45°, squash y).",
    "recommendedCameraScale": "the web game shows ~23 m across a portrait iPhone (≈17–18 pt/m): SKCameraNode.setScale(1.35) (≈18 pt/m) matches it; 1.0 is a closer view at native sprite resolution"
  },
  "lighting": {
    "rig": "sprites are pre-lit with a bright \"full light\" rig: the game's moon direction (-25, 60, 35), cool sky dome, warm fill from the viewer (flashlights). ACES filmic, sRGB.",
    "inGameDarkness": "multiply by a light map: about [0.27, 0.31, 0.42] in the dark (moon + sky only), 1.0 inside flashlight cones / lamp pools, >1 not possible with multiply — add light pools additively instead",
    "glowLayers": "BugsGlow / MarinesGlow hold the emissive parts only (pink / acid / ember speckles, visors, lamps) with a soft halo, premultiplied: draw ABOVE the darkness with blendMode .add at the same position, anchor and scale (they are @2x-only images with the same point size as the lit frame)",
    "bugBrightness": "bug frames use instance brightness 1.15; the web game varies it per bug 0.55…1.3 → multiply color by 0.48…1.13 (colorBlendFactor 1, SKColor(white:))"
  },
  "atlasNotes": "Sprite atlases live in Assets.xcassets/*.spriteatlas (Xcode packs them into pages per scale and trims transparent borders itself; SKTexture.size() keeps the untrimmed frame size, so the anchors below stay valid). Load with SKTextureAtlas(named: \"Bugs\").textureNamed(\"runner_walk_03_5\"). Frame names are unique across atlases. Lit frames have @2x + @3x, glow frames @2x only.",
